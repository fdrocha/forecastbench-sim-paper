# Copy to .env (not committed) and adjust. Command-line flags and shell variables take precedence over this file.
# Paths only; this package never calls providers, so no API keys belong here.

# The forecastbench-sim checkout whose fbsim-core and fbsim-benchmark build_paper.sh installs.
FBSIM_REPO_ROOT=~/fri/forecastbench-sim

# The manuscript checkout: the folder with main.tex.
FBSIM_PAPER_ROOT=~/fri/fbs-paper-overleaf

# The data archive's data/ folder (the one holding datasets/ and manifests/).
FBSIM_DATA_ROOT=~/fri/all-data/data
